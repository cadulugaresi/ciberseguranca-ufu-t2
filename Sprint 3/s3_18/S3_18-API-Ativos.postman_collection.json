              "pm.test(\"Status é 201\", () => {\n    pm.response.to.have.status(201);\n});\n\npm.test(\"Ativo criado com o nome certo e com id\", () => {\n    const dados = pm.response.json();\n    pm.expect(dados.nome).to.eql(\"Câmera de Segurança\");\n    pm.expect(dados).to.have.property(\"id\");\n    pm.collectionVariables.set(\"ativoId\", dados.id); // guarda o id pras próximas requests\n});"
            ]
          }
        }
